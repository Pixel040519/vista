# Dependencies
node_modules/
vista-backend/fastapi-ai/venv/

# Python bytecode
__pycache__/
*.pyc

# Synthetic training data — regenerated from a seed by
# fastapi-ai/scripts/generate_synthetic.py. The trained models in
# fastapi-ai/models/ are small and stay tracked so the demo needs no training run.
vista-backend/fastapi-ai/data/

# Environment
.env
*.env.local

# Build output
vista-dashboard/dist/

# Uploaded media — profile, announcement and facility photos are pictures of
# real people. The docs already said this was ignored; the rule was missing.
vista-backend/node-api/uploads/

# Claude Code
# CLAUDE.md files are tracked on purpose — they are the project's architecture
# notes, not local scratch. `.claude/` stays ignored: that is per-machine session
# and settings state.
.claude/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
