NODE_ENV=development
PORT=5000

# Browser origins allowed to call the API, comma-separated. Unset means ANY
# origin (fine for local development, never for production). The landing page
# reads /api/public/* from its own origin, so list it alongside the dashboard:
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Database
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD="your_password"
DB_NAME=vista_db
DB_PORT=5432

# JWT
JWT_SECRET=your_super_secret_jwt_key
JWT_REFRESH_SECRET=refreshsecret456
JWT_EXPIRES_IN=1d

# Mail — parent portal activation and password-reset codes
#
# Without these, an invited parent can never receive a code and the activation
# flow stops at the first screen. Any SMTP provider works; a Gmail account with
# 2FA plus an App Password is enough for development.
MAIL_FROM="VISTA <no-reply@vista.school>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_account@gmail.com
SMTP_PASSWORD=your_16_char_app_password
# SMTP_SECURE=true          # only for port 465 (implicit TLS)

# Development only. Prints activation codes to the console instead of sending
# them, so the flow can be exercised with no mail server. It REFUSES to start
# when NODE_ENV=production, because printing codes to a log is exactly what the
# rest of this design avoids.
# MAIL_TRANSPORT=console
# Firebase Cloud Messaging — push notifications for school announcements
#
# Optional: without these, pushes are skipped and logged. Take the three values
# from Firebase console → Project settings → Service accounts → Generate new
# private key. Keep the private key in double quotes on one line, with its \n
# escapes as they appear in the JSON. That JSON is a full-access credential —
# never commit it.
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
