# Where the VISTA dashboard is served from. The Portal page's staff sign-in
# links lead to its /login.
#
# Copy this file to .env.local and adjust per environment.
#   dev  — the dashboard's dev server (vista-dashboard/vite.config.js pins 5173)
#   prod — wherever the dashboard is deployed, e.g. https://portal.nrys.edu.ph
#
# Omitting it falls back to http://localhost:5173.
VITE_VISTA_URL=http://localhost:5173

# Where the VISTA Node API is served from. Optional. The site reads public
# announcements and the facility gallery from /api/public/* on it, and falls
# back to what it ships with whenever this is unset or unreachable.
# The API's ALLOWED_ORIGINS must include this site's origin.
VITE_API_URL=http://localhost:5000

# Store listings for the parent app, shown as download buttons on /portal.
# Optional, each on its own: a button appears only for a link that is set, and
# with neither the page points parents to the school office instead.
VITE_PARENT_APP_ANDROID_URL=
VITE_PARENT_APP_IOS_URL=
